        "workspace_pick": "Ordner wählen…",
        "workspace_clear": "Entfernen",
        "workspace_auto": "Bearbeiten von Dateien in diesem Ordner im automatischen Modus erlauben",
        "sandbox_toggle": "Nur-Lese-Befehle in einer System-Sandbox isolieren ({kind})",
    },
}
DURATIONS = (("hour", 60), ("hours", 480), ("forever", 0))


def state() -> dict:
    data = ornis_consent.settings()
    running = [j for j in ornis_shell.jobs(20) if not j.get("done")]
    return {"mode": data["mode"], "until": data["until"], "rules": data["rules"],
            "workspace": data.get("workspace", ""), "workspace_auto": bool(data.get("workspace_auto", True)),
            "sandbox": bool(data.get("sandbox", True)),
            "running": [{"job": j["job"], "label": j["label"], "seconds": j["seconds"]} for j in running]}


def cli(argv: list[str]) -> int | None:
    if "--state" in argv:
        print(json.dumps(state(), ensure_ascii=False))
        return 0
    if "--mode" in argv:
        mode = argv[argv.index("--mode") + 1] if len(argv) > argv.index("--mode") + 1 else "ask"
        minutes = int(argv[argv.index("--minutes") + 1]) if "--minutes" in argv else 0
        print(json.dumps(ornis_consent.set_mode(mode, minutes), ensure_ascii=False))
        return 0
    if "--workspace" in argv:
        ws = argv[argv.index("--workspace") + 1] if len(argv) > argv.index("--workspace") + 1 else ""
        print(json.dumps(ornis_consent.set_workspace(ws), ensure_ascii=False))
        return 0
    if "--stop-all" in argv:
        for job in state()["running"]:
            ornis_shell.stop(job["job"])
        return 0
    return None


def window() -> int:
    from PySide6.QtCore import Qt, QTimer
    from PySide6.QtGui import QFontDatabase, QIcon
    from PySide6.QtWidgets import (QApplication, QCheckBox, QComboBox, QFileDialog, QHBoxLayout, QPlainTextEdit, QVBoxLayout, QWidget)
    from orneosui import Card, Header, Segments, WIDTH, button, hairline, label, page, setup, tokens

    import ornis_desktop
    import ornis_local

    app = QApplication(sys.argv[:1])
    app.setApplicationName("Ornis")
    app.setDesktopFileName("eu.orneos.ornis-computer")
    setup(app)
    c = tokens(app)
    t = TEXT.get((os.environ.get("LANG") or "fr")[:2], TEXT["en"])
    mono = QFontDatabase.systemFont(QFontDatabase.FixedFont)
    mono.setFamily("JetBrains Mono")
    mono.setPointSizeF(9.5)

    win = QWidget()
    win.setObjectName("page")
    win.setWindowTitle(t["title"])
    win.setWindowIcon(QIcon.fromTheme("eu.orneos.ornis", QIcon.fromTheme("orneos")))
    outer = QVBoxLayout(win)
    outer.setContentsMargins(0, 0, 0, 0)
    outer.setSpacing(0)
    outer.addWidget(Header(t["title"], t["subtitle"]))
    area, col = page()
    outer.addWidget(area)

    def clear(layout):
        while layout.count():
            item = layout.takeAt(0)
            if item.widget():
                item.widget().deleteLater()
            elif item.layout():
                clear(item.layout())

    # ---- mode -------------------------------------------------------------------------------------------------
    perm = Card(t["permissions"])
    segments = Segments([("ask", t["ask"]), ("auto", t["auto"]), ("full", t["full"])])
    perm.body.addWidget(segments)
    explain = label("", "muted")
    perm.body.addWidget(explain)
    row = QHBoxLayout()
    row.addWidget(label(t["for"], wrap=False))
    duration = QComboBox()
    for key, _minutes in DURATIONS:
        duration.addItem(t[key], key)
    row.addWidget(duration)
    row.addStretch(1)
    duration_row = QWidget()
    duration_row.setLayout(row)
    perm.body.addWidget(duration_row)
    until = label("", "muted")
    perm.body.addWidget(until)
    sb_kind = ornis_local.sandbox_available()    # "bwrap", "seatbelt", or "" when there is none
    sb_check = None
    if sb_kind:
        sb_check = QCheckBox(t["sandbox_toggle"].format(kind=SANDBOX_NAMES.get(sb_kind, sb_kind)))
        sb_check.setChecked(bool(ornis_consent.settings().get("sandbox", True)))
        sb_check.toggled.connect(lambda v: ornis_consent.set_sandbox(bool(v)))
        perm.body.addWidget(sb_check)
    col.addWidget(perm)

    # ---- workspace --------------------------------------------------------------------------------------------
    ws_card = Card(t["workspace"])
    ws_path_label = label("", "muted")
    ws_card.body.addWidget(ws_path_label)
    ws_auto_check = QCheckBox(t["workspace_auto"])
    ws_card.body.addWidget(ws_auto_check)
    ws_btns = QHBoxLayout()
    ws_pick = button(t["workspace_pick"])
    ws_clear = button(t["workspace_clear"], "quiet")
    ws_btns.addWidget(ws_pick)
    ws_btns.addWidget(ws_clear)
    ws_btns.addStretch(1)
    ws_card.body.addLayout(ws_btns)
    col.addWidget(ws_card)

    def show_workspace():
        data = ornis_consent.settings()
        ws = data.get("workspace") or ""
        if ws:
            ws_path_label.setText(ws)
            ws_path_label.setFont(mono)
            ws_clear.setVisible(True)
            ws_auto_check.setVisible(True)
            ws_auto_check.blockSignals(True)
            ws_auto_check.setChecked(bool(data.get("workspace_auto", True)))
            ws_auto_check.blockSignals(False)
        else:
            ws_path_label.setText(t["workspace_none"])
            ws_clear.setVisible(False)
            ws_auto_check.setVisible(False)

    def pick_workspace():
        cur = ornis_consent.settings().get("workspace") or str(Path.home())
        chosen = QFileDialog.getExistingDirectory(win, t["workspace"], cur)
        if chosen:
            ornis_consent.set_workspace(chosen)
            show_workspace()

    ws_pick.clicked.connect(pick_workspace)
    ws_clear.clicked.connect(lambda: (ornis_consent.set_workspace(""), show_workspace()))
    ws_auto_check.toggled.connect(lambda v: ornis_consent.set_workspace(ornis_consent.settings().get("workspace") or "", auto_write=bool(v)))
    show_workspace()
    from ornis_extensions_ui import open_dialog, TEXT as EXT_TEXT
    import ornis_extensions
    ext_title = EXT_TEXT.get((os.environ.get("LANG") or "fr")[:2], EXT_TEXT["en"])[0]
    ext_card = Card(ext_title)
    ext_summary = label("", "muted")
    ext_card.body.addWidget(ext_summary)
    ext = button(ext_title + "…")
    ext_card.body.addWidget(ext, 0, Qt.AlignLeft)
    col.addWidget(ext_card)

    def show_extensions():
        try:
            cat = ornis_extensions.catalogue()
            ns, nm = len(cat.get("skills") or []), len(cat.get("mcpServers") or [])
            lang = (os.environ.get("LANG") or "fr")[:2]
            if lang == "fr":
                ext_summary.setText(f"{ns} Skill(s) installé(s) · {nm} serveur(s) MCP actif(s)")
            elif lang == "de":
                ext_summary.setText(f"{ns} Skill(s) installiert · {nm} aktive(r) MCP-Server")
            else:
                ext_summary.setText(f"{ns} skill(s) installed · {nm} active MCP server(s)")
        except Exception:
            pass

    ext.clicked.connect(lambda: (open_dialog(win), show_extensions()))
    show_extensions()


    def show_mode():
        data = ornis_consent.settings()
        segments.set_value(data["mode"])
        explain.setText(t[data["mode"] + "_text"])
        duration_row.setVisible(data["mode"] != "ask")
        until.setVisible(data["mode"] != "ask")
        if data["until"]:
            until.setText(t["until"].format(time=time.strftime("%H:%M", time.localtime(data["until"]))))
            remaining = (data["until"] - time.time()) / 60
            duration.setCurrentIndex(0 if remaining <= 60 else 1)
        else:
            until.setText(t["always_on"])
            duration.setCurrentIndex(2)
        until.setStyleSheet(f"color: {c['saffron'] if data['mode'] == 'full' else c['muted']};")

    def set_mode(mode=None):
        mode = mode or segments.value()
        key = duration.currentData()
        minutes = dict(DURATIONS)[key]
        if mode == "full" and ornis_consent.settings()["mode"] != "full" and key == "forever":
            minutes = 60            # autonomous starts for an hour; « Toujours » is a second, deliberate choice
            duration.setCurrentIndex(0)
        ornis_consent.set_mode(mode, minutes)
        show_mode()

    segments.group.buttonClicked.connect(lambda _btn: set_mode())
    duration.activated.connect(lambda _i: set_mode(ornis_consent.settings()["mode"]))
    show_mode()

    # ---- rules ------------------------------------------------------------------------------------------------
    rules_card = Card(t["rules"])
    rules_box = QVBoxLayout()
    rules_card.body.addLayout(rules_box)
    col.addWidget(rules_card)

    def show_rules():
        clear(rules_box)
        rules = ornis_consent.settings()["rules"]
        if not rules:
            rules_box.addWidget(label(t["no_rules"], "muted"))
        for rule in rules:
            line = QHBoxLayout()
            name = label(rule.get("label") or rule["value"], wrap=False)
            if rule["kind"] == "command":
                name.setFont(mono)
            line.addWidget(name, 1)
            remove = button(t["remove"], "quiet")
            remove.clicked.connect(lambda _=False, r=rule: (ornis_consent.remove_rule(r["kind"], r["value"]), show_rules()))
            line.addWidget(remove)
            rules_box.addLayout(line)

    show_rules()

    # ---- running commands ---------------------------------------------------------------------------------------
    jobs_card = Card(t["running"])
    jobs_box = QVBoxLayout()
    jobs_card.body.addLayout(jobs_box)
    col.addWidget(jobs_card)
    seen = {"jobs": None, "journal": None}

    def duration_text(seconds):
        return t["seconds"].format(s=seconds) if seconds < 120 else t["minutes"].format(m=seconds // 60)

    def show_jobs():
        running = [j for j in ornis_shell.jobs(20) if not j.get("done")]
        sig = json.dumps([(j["job"], j["output"][-400:]) for j in running])
        if sig == seen["jobs"]:
            return
        seen["jobs"] = sig
        clear(jobs_box)
        jobs_card.setVisible(bool(running))
        for j in running:
            head = QHBoxLayout()
            head.addWidget(label(j["label"], "title"), 1)
            head.addWidget(label(duration_text(j["seconds"]), "muted", wrap=False))
            stop = button(t["stop"], "danger")
            stop.clicked.connect(lambda _=False, job=j["job"]: (ornis_shell.stop(job), refresh()))
            head.addWidget(stop)
            jobs_box.addLayout(head)
            out = QPlainTextEdit("\n".join(j["output"].splitlines()[-8:]))
            out.setReadOnly(True)
            out.setFont(mono)
            out.setFixedHeight(120)
            jobs_box.addWidget(out)
        if len(running) > 1:
            stop_all = button(t["stop_all"], "danger")
            stop_all.clicked.connect(lambda: (cli(["--stop-all"]), refresh()))
            jobs_box.addWidget(stop_all, 0, Qt.AlignRight)

    # ---- activity -------------------------------------------------------------------------------------------------
    act_card = Card(t["activity"])
    act_box = QVBoxLayout()
    act_card.body.addLayout(act_box)
    col.addWidget(act_card)

    def when(ts):
        moment = time.localtime(ts)
        return time.strftime("%H:%M" if time.strftime("%Y%m%d", moment) == time.strftime("%Y%m%d") else "%d/%m %H:%M", moment)

    def show_activity():
        rows = ornis_consent.journal(40)
        sig = json.dumps([(r.get("id"), r.get("outcome"), r.get("undone")) for r in rows])
        if sig == seen["journal"]:
            return
        seen["journal"] = sig
        clear(act_box)
        if not rows:
            act_box.addWidget(label(t["no_activity"], "muted"))
            return
        for i, r in enumerate(rows):
            if i:
                act_box.addWidget(hairline())
            line = QHBoxLayout()
            line.setSpacing(10)
            line.addWidget(label(when(r.get("at") or 0), "muted", wrap=False), 0, Qt.AlignTop)
            text_col = QVBoxLayout()
            text_col.setSpacing(2)
            text_col.addWidget(label((r.get("summary") or r.get("action") or "").split("\n")[0]))
            if r.get("command"):
                cmd = label(r["command"][:300])
                cmd.setFont(mono)
                cmd.setStyleSheet(f"color: {c['muted']};")
                text_col.addWidget(cmd)
            decision = r.get("decision") or ""
            tag = t.get("auto_d" if decision == "auto" else decision, decision)
            if r.get("outcome") == "error":
                tag += " · " + t["error"]
            tone = c["danger"] if decision in ("denied", "blocked", "timeout") or r.get("outcome") == "error" else c["muted"]
            chip = label(tag, wrap=False)
            chip.setStyleSheet(f"color: {tone}; font-size: 11px; font-weight: 600;")
            text_col.addWidget(chip)
            line.addLayout(text_col, 1)
            if isinstance(r.get("undo"), dict):
                if r.get("undone"):
                    line.addWidget(label(t["undone"], "muted", wrap=False), 0, Qt.AlignTop)
                else:
                    undo = button(t["undo"], "quiet")
                    undo.clicked.connect(lambda _=False, e=r["id"]: (ornis_desktop.undo(e), refresh()))
                    line.addWidget(undo, 0, Qt.AlignTop)
            act_box.addLayout(line)
        wipe = button(t["clear"], "quiet")
        wipe.clicked.connect(lambda: (ornis_consent.clear_journal(), refresh()))
        act_box.addWidget(wipe, 0, Qt.AlignRight)

    never = Card(t["never"])
    for key in ("never_secrets", "never_destroy", "never_power"):
        never.body.addWidget(label(t[key], "muted"))
    col.addWidget(never)
    col.addStretch(1)

    def refresh():
        show_mode()
        show_jobs()
        show_activity()

    refresh()
    timer = QTimer(win)
    timer.timeout.connect(refresh)
    timer.start(2000)

    win.setFixedWidth(WIDTH + 40)
    screen = app.primaryScreen()
    win.resize(WIDTH + 40, min(820, (screen.availableGeometry().height() - 80) if screen else 820))
    if os.environ.get("ORNIS_COMPUTER_SHOT"):           # tests: a picture, then quit
        QTimer.singleShot(700, lambda: (win.grab().save(os.environ["ORNIS_COMPUTER_SHOT"]), app.quit()))
    win.show()
    if "--extensions" in sys.argv[1:]:
        QTimer.singleShot(100, lambda: (open_dialog(win), show_extensions()))
    return app.exec()


if __name__ == "__main__":
    code = cli(sys.argv[1:])
    sys.exit(code if code is not None else window())
