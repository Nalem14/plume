#!/usr/bin/python3
"""Ornis on this computer: what it may do without asking, what it is running, what it did.

  orneos-ornis-computer                     the window (mode, « toujours autorisé », commands running, activity)
  orneos-ornis-computer --state             {mode, until, rules, running} as JSON, for the Ornis app and applet
  orneos-ornis-computer --mode ask|auto|full [--minutes N]
  orneos-ornis-computer --stop-all          stops every command Ornis started that still runs

The mode and the rules live in ~/.config/orneos/ornis-computer.json (ornis_consent), the journal and the commands
in ~/.local/state/orneos. Undoing an entry (a move, a written file, a new folder) goes through ornis_desktop.undo.
"""
from __future__ import annotations

import json
import os
import sys
import time

from pathlib import Path
shared = Path(__file__).resolve().parent.parent / "share" / "orneos"
if not shared.is_dir():
    shared = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(shared))
import ornis_consent  # noqa: E402
import ornis_shell  # noqa: E402

# the system sandbox, as people know it
SANDBOX_NAMES = {"bwrap": "bubblewrap", "seatbelt": "macOS"}

