#!/usr/bin/python3
"""Asks the user whether Ornis may do something on this computer (ornis_consent.ask).

Reads the request as JSON on stdin ({action, level, summary, reason, command, cwd, sensitive, can_always, rule,
source, mode, seconds}), shows it, and prints the answer as one JSON line: {"answer": "allow" | "always" | "deny",
"command": the command as the user left it, "timeout": true when nobody answered}. Closing the window is a no.

A command can be changed before it runs. What touches the whole system or a secret is said plainly, and « Refuser »
has the focus then: Entrée never runs it by accident.
"""
from __future__ import annotations

import json
import os
import sys

from PySide6.QtCore import Qt, QTimer
from PySide6.QtGui import QColor, QFontDatabase, QIcon, QKeySequence, QShortcut, QSyntaxHighlighter, QTextCharFormat
from PySide6.QtWidgets import QApplication, QCheckBox, QDialog, QHBoxLayout, QPlainTextEdit, QVBoxLayout, QWidget

from pathlib import Path
shared = Path(__file__).resolve().parent.parent / "share" / "orneos"
if not shared.is_dir():
    shared = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(shared))
from orneosui import Banner, Card, Header, button, fit, hairline, label, page, setup, tokens  # noqa: E402

